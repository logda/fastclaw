# FastClaw Docker Compose Environment Configuration
#
# Copy this file to .env and modify as needed:
#   cp .env.example .env
#
# All variables have defaults in docker-compose.yml, so .env is optional.
# Override by:
#   1. Creating .env file (copy this file)
#   2. Command line: FASTCLAW_TAG=v1.0.0 docker compose up -d

# --- Image Tags ---
# FastClaw main image (built via: make build-docker IMAGE_TAG=<value>)
FASTCLAW_TAG=latest

# Sandbox image (built via: cd deploy/docker/sandbox && ./build.sh -t <value>)
SANDBOX_TAG=latest

# --- Network ---
# Gateway port (host port mapping)
FASTCLAW_PORT=18953

# --- Database ---
# Postgres password (used by both postgres and fastclaw services)
POSTGRES_PASSWORD=fastclaw-secret

# --- Usage ---
# Default (latest images):
#   docker compose up -d
#
# With specific versions:
#   FASTCLAW_TAG=v1.0.0 SANDBOX_TAG=v1.0.0 docker compose up -d
#
# With .env file:
#   cp .env.example .env
#   # Edit .env to set your values
#   docker compose up -d